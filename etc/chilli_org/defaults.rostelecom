# -*- mode: shell-script; -*-
#
#   Coova-Chilli Default Configurations.
#   To customize, copy this file to /etc/chilli/config
#   and edit to your liking. This is included in shell scripts
#   that configure chilli and related programs before file 'config'.


#############################################################

HS_LANIF=wlan0-va3             # Subscriber Interface for client devices
HS_NETWORK=192.168.182.0        # HotSpot Network (must include HS_UAMLISTEN)
HS_NETMASK=255.255.254.0   # HotSpot Network Netmask
HS_UAMLISTEN=192.168.182.1      # HotSpot IP Address (on subscriber network)
HS_UAMPORT=3990            # HotSpot UAM Port (on subscriber network)
HS_UAMUIPORT=4990          # HotSpot UAM "UI" Port (on subscriber network, for embedded portal)
HS_DYNIP=192.168.182.10
HS_DYNIP_MASK=255.255.254.0
HS_LEASE=57600
HS_SWAPOCTETS="on"
HS_DNS_DOMAIN=key.chillispot.info

HS_DNS1=8.8.8.8
HS_DNS2=208.67.222.222

HS_NASID=
HS_UAMSERVER="auth.wifi.rt.ru"
HS_UAMSECRET=
HS_RADSECRET="no_secret"    # Set to be your RADIUS shared secret
HS_AAA="radius"

HS_RADIUS=radius.wifi.rt.ru
HS_RADIUS2=

HS_UAMHOMEPAGE=""
HS_UAMFORMAT="https://auth.wifi.rt.ru"
HS_PROVIDER=Rostelecom
HS_PROVIDER_LINK=https://www.company.rt.ru

HS_MODE=hotspot
HS_TYPE=chillispot

HS_UAMALIASNAME=chilli
HS_RADCONF=off           # Get some configurations from RADIUS or a URL ('on' and 'url' respectively)

HS_MACAUTH=on
HS_MACALLOW=1

HS_UAMALLOW=""
HS_UAMDOMAINS="client.wifi.rt.ru vk.me pdp-waf.wifi.rt.ru .wifi.rt.ru passport.rt.ru id.sber.ru oauth.sber.ru passport.yandex.ru oauth.yandex.ru login.yandex.ru mc.yandex.ru yastatic.net .vk.com .ok.ru .odnoklassniki.ru okcdn.ru mycdn.me .gosuslugi.ru gu-st.ru id-sandbox.alfabank.ru id.alfabank.ru"

